# =================================================================
# HUYỀN HỌC BA HỆ THỐNG (KỲ MÔN - TỬ VI - BÁT TỰ) - CONFIGURATION
# =================================================================

# 1. Cấu hình AI Gemini (Khuyên dùng - Nhanh, chuẩn và hỗ trợ tốt tiếng Việt)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Hoặc Cấu hình OpenAI-compatible (OpenAI, DeepSeek, Groq, OpenRouter, Local LLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 3. Múi giờ mặc định
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
